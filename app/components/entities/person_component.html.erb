<article id="<%= dom_id person %>" class="entities---person origami-paper" data-compiler="entities-person" up-data="<%= {  }.to_json %>">
  <div class="entities---person--header">
    <span class="entities---person--avatar" aria-hidden="true"><%= initials %></span>
    <h2 class="entities---person--name">
      <%= link_to person.name, person %>
      <% if defined?(Avo) %> <%= link_to "✏️", avo.resources_entities_person_path(person), "up-follow": false %><% end %>
    </h2>
  </div>

  <% if person.talks.any? %>
    <ul class="entities---person--talks">
      <% person.talks.each do |talk| %>
        <li><%= link_to talk, talk %> <span class="muted">at <%= link_to talk.event, talk.event %></span></li>
      <% end %>
    </ul>
  <% end %>

  <% if links.any? %>
    <p class="entities---person--links">
      <% links.each do |name, url| %>
        <%= link_to name, url, target: "_blank", rel: "noopener noreferrer" %>
      <% end %>
    </p>
  <% end %>
</article>
