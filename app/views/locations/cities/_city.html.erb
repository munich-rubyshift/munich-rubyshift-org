<article id="<%= dom_id city %>">
  <p>
    <strong>Slug:</strong>
    <%= city.slug %>
  </p>

  <p>
    <strong>Name:</strong>
    <%= city.name %>
  </p>

  <p>
    <strong>Rubyevents slug:</strong>
    <%= city.rubyevents_slug %>
  </p>

  <p>
    <strong>State code:</strong>
    <%= city.state_code %>
  </p>

  <p>
    <strong>Country code:</strong>
    <%= city.country_code %>
  </p>

  <p>
    <strong>Locations coordinates:</strong>
    <%= city.locations_coordinates_id %>
  </p>

</article>
