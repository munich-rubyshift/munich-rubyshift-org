<article id="<%= dom_id address %>">
  <p>
    <strong>Slug:</strong>
    <%= address.slug %>
  </p>

  <p>
    <strong>Street:</strong>
    <%= address.street %>
  </p>

  <p>
    <strong>Zip code:</strong>
    <%= address.zip_code %>
  </p>

  <p>
    <strong>Locations city:</strong>
    <%= address.locations_city_id %>
  </p>

</article>
