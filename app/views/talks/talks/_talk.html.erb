<article id="<%= dom_id talk %>">
  <p>
    <strong>Slug:</strong>
    <%= talk.slug %>
  </p>

  <p>
    <strong>Title:</strong>
    <%= talk.title %>
  </p>

  <p>
    <strong>Rubyevents slug:</strong>
    <%= talk.rubyevents_slug %>
  </p>

  <p>
    <strong>Speakers:</strong><br>
    <ul>
      <% talk.speakers.each do |speaker| %>
        <li><%= link_to speaker %></li>
      <% end %>
    </ul>
  </p>

  <p>
    <strong>Event:</strong>
    <%= link_to talk.event %>
  </p>

  <p>
    <strong>Position:</strong>
    <%= talk.position %>
  </p>

  <p>
    <strong>Description:</strong>
    <%= talk.description %>
  </p>

  <p>
    <strong>Slides url:</strong>
    <%= talk.slides_url %>
  </p>

  <p>
    <strong>Kind:</strong>
    <%= talk.kind %>
  </p>

  <p>
    <strong>Announced on:</strong>
    <%= talk.announced_on %>
  </p>

  <p>
    <strong>Language:</strong>
    <%= talk.language %>
  </p>

</article>
