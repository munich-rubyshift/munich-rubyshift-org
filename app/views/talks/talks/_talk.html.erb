<% resources = { "Slides" => talk.slides_url, "Video" => talk.external_player_url.presence || (talk.video_id.presence && talk.video_provider == "youtube" && "https://www.youtube.com/watch?v=#{talk.video_id}") }.compact_blank %>

<article id="<%= dom_id talk %>" class="talk-page">
  <p class="talk-page--kicker">
    <%= link_to talk.event, talk.event %> · <%= event_date(talk.event) %>
  </p>

  <h1><%= talk.title %></h1>

  <% if talk.speakers.any? %>
    <p class="talk-page--speakers">
      by <%= safe_join(talk.speakers.map { |speaker| link_to(speaker, speaker) }, ", ") %>
    </p>
  <% end %>

  <% if resources.any? || talk.additional_resources.any? %>
    <p>
      <% resources.each do |name, url| %>
        <%= link_to name, url, class: "button", target: "_blank", rel: "noopener noreferrer" %>
      <% end %>
      <% talk.additional_resources.each do |resource| %>
        <%= link_to resource.name, resource.url, class: "button button-secondary", target: "_blank", rel: "noopener noreferrer" %>
      <% end %>
    </p>
  <% end %>

  <% if talk.description.present? %>
    <div class="talk-page--description">
      <%= simple_format(talk.description) %>
    </div>
  <% end %>

  <% if talk.speakers.any? %>
    <h2 class="section-title"><%= "Speaker".pluralize(talk.speakers.size) %></h2>
    <div class="people-grid">
      <% talk.speakers.each do |speaker| %>
        <%= render Entities::PersonComponent.new(speaker) %>
      <% end %>
    </div>
  <% end %>
</article>
