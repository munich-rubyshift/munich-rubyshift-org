<article id="<%= dom_id organization %>">
  <p>
    <strong>Slug:</strong>
    <%= organization.slug %>
  </p>

  <p>
    <strong>Name:</strong>
    <%= organization.name %>
  </p>

  <p>
    <strong>Legal name:</strong>
    <%= organization.legal_name %>
  </p>

  <p>
    <strong>Rubyevents slug:</strong>
    <%= organization.rubyevents_slug %>
  </p>

  <p>
    <strong>Hosted events:</strong><br>
    <ul>
      <% organization.hosted_events.by_start_date.reverse_order.includes(:venue).each do |event| %>
        <li><%= link_to event %> at <%= link_to event.venue %></li>
      <% end %>
    </ul>
  </p>

  <p>
    <strong>Website:</strong>
    <%= link_to organization.website, organization.website, target: "_blank", rel: "noopener noreferrer" if organization.website.present? %>
  </p>

  <p>
    <strong>Logo url:</strong>
    <%= organization.logo_url %>
  </p>

</article>
