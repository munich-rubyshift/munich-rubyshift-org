<article id="<%= dom_id event %>">
  <p>
    <strong>Slug:</strong>
    <%= event.slug %>
  </p>

  <p>
    <strong>Title:</strong>
    <%= event.title %>
  </p>

  <p>
    <strong>Rubyevents slug:</strong>
    <%= event.rubyevents_slug %>
  </p>

  <p>
    <strong>Venue:</strong>
    <%= link_to event.venue if event.venue %>
  </p>

  <p>
    <strong>Participants:</strong>
    <%= event.participants.count %>
  </p>

  <p>
    <strong>Talks:</strong><br>
    <ul>
      <% event.talks.each do |talk| %>
        <li><%= link_to talk %> by <%= talk.speakers.by_to_s.join(", ") %></li>
      <% end %>
    </ul>
  </p>

  <p>
    <strong>Description:</strong>
    <%= event.description %>
  </p>

  <p>
    <strong>Kind:</strong>
    <%= event.kind %>
  </p>

  <p>
    <strong>Attendance mode:</strong>
    <%= event.attendance_mode %>
  </p>

  <p>
    <strong>Status:</strong>
    <%= event.status %>
  </p>

  <p>
    <strong>Last edition:</strong>
    <%= event.last_edition %>
  </p>

  <p>
    <strong>Start date:</strong>
    <%= event.start_date %>
  </p>

  <p>
    <strong>Start time:</strong>
    <%= event.start_time %>
  </p>

  <p>
    <strong>End date:</strong>
    <%= event.end_date %>
  </p>

  <p>
    <strong>End time:</strong>
    <%= event.end_time %>
  </p>

  <p>
    <strong>Published at:</strong>
    <%= event.published_at %>
  </p>

  <p>
    <strong>Announced on:</strong>
    <%= event.announced_on %>
  </p>

  <p>
    <strong>Date precision:</strong>
    <%= event.date_precision %>
  </p>

  <p>
    <strong>Website:</strong>
    <%= event.website %>
  </p>

  <p>
    <strong>Twitter username:</strong>
    <%= event.twitter_username %>
  </p>

  <p>
    <strong>Mastodon:</strong>
    <%= event.mastodon %>
  </p>

  <p>
    <strong>Github:</strong>
    <%= event.github %>
  </p>

  <p>
    <strong>Meetup:</strong>
    <%= event.meetup %>
  </p>

  <p>
    <strong>Luma:</strong>
    <%= event.luma %>
  </p>

  <p>
    <strong>Tickets url:</strong>
    <%= event.tickets_url %>
  </p>

</article>
