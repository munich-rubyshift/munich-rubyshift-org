<% sponsorships = event.sponsor_tiers.flat_map { |tier| tier.organizations.map { |organization| [ organization, tier ] } } %>
<% links = { "Meetup" => event.meetup, "Website" => event.website, "YouTube" => event.youtube, "Luma" => event.luma, "GitHub" => event.github, "Mastodon" => event.mastodon }.compact_blank %>

<article id="<%= dom_id event %>" class="event-page">
  <header class="event-page--header">
    <%= render Events::DateBadgeComponent.new(event.start_date, precision: event.date_precision.presence || "day") %>
    <div>
      <h1>
        <%= event_title(event) %>
        <% if event.cancelled? %><span class="tag tag-muted">Cancelled</span><% end %>
        <% if event.status == "postponed" %><span class="tag tag-muted">Postponed</span><% end %>
      </h1>
      <% if event.tickets_url.present? || links.any? %>
        <p>
          <% if event.tickets_url.present? %>
            <%= link_to event_upcoming?(event) ? "RSVP" : "Event page", event.tickets_url, class: "button", target: "_blank", rel: "noopener noreferrer" %>
          <% end %>
          <% links.each do |name, url| %>
            <%= link_to name, url, class: "button button-secondary", target: "_blank", rel: "noopener noreferrer" %>
          <% end %>
        </p>
      <% end %>
    </div>
  </header>

  <dl class="facts">
    <div>
      <dt>Date</dt>
      <dd><%= event_date(event) %></dd>
    </div>
    <% if (time_range = event_time_range(event)) %>
      <div>
        <dt>Time</dt>
        <dd><%= time_range %></dd>
      </div>
    <% end %>
    <% if event.venue %>
      <div>
        <dt>Venue</dt>
        <dd>
          <%= link_to event.venue, event.venue %>
          <% if event.venue.address %><br><span class="muted"><%= event.venue.address %></span><% end %>
        </dd>
      </div>
    <% end %>
    <% if event.attendance_mode.present? && event.attendance_mode != "in_person" %>
      <div>
        <dt>Attendance</dt>
        <dd><%= event.attendance_mode.humanize %></dd>
      </div>
    <% end %>
    <% if event.participants.any? %>
      <div>
        <dt>Participants</dt>
        <dd><%= event.participants.count %></dd>
      </div>
    <% end %>
  </dl>

  <% if event.talks.any? %>
    <h2 class="section-title">Talks</h2>
    <ul class="event-page--talks">
      <% event.talks.each do |talk| %>
        <li>
          <%= link_to talk, talk %>
          <% if talk.speakers.any? %><span class="muted">by <%= safe_join(talk.speakers.map { |speaker| link_to(speaker, speaker) }, ", ") %></span><% end %>
        </li>
      <% end %>
    </ul>
  <% end %>

  <% if event.description.present? %>
    <h2 class="section-title">About this event</h2>
    <div class="event-page--description">
      <%= simple_format(event.description) %>
    </div>
  <% end %>

  <% if sponsorships.any? %>
    <h2 class="section-title">Sponsors</h2>
    <ul>
      <% sponsorships.each do |organization, tier| %>
        <li><%= link_to organization, organization %> <span class="muted">(<%= tier %>)</span></li>
      <% end %>
    </ul>
  <% end %>

  <% if event.involvements.any? %>
    <h2 class="section-title">Thanks to</h2>
    <ul>
      <% event.involvements.includes(:entity).group_by(&:role).each do |role, involvements| %>
        <li><%= role %>: <%= safe_join(involvements.map { |involvement| link_to(involvement.entity, involvement.entity) }, ", ") %></li>
      <% end %>
    </ul>
  <% end %>
</article>
