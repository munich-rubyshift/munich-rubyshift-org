<% content_for :title, "#{event_title(@events_event)} · #{event_date(@events_event)}" %>

<%= render @events_event %>

<p class="page-actions">
  <%= link_to "← All events", events_events_path %>
  <% if defined?(Avo) %>
    <%= link_to "✏️", avo.resources_events_event_path(@events_event), "up-follow": false %>
  <% end %>
</p>
