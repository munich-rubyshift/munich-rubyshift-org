<article id="<%= dom_id cfp %>">
  <p>
    <strong>Slug:</strong>
    <%= cfp.slug %>
  </p>

  <p>
    <strong>Name:</strong>
    <%= cfp.name %>
  </p>

  <p>
    <strong>External url:</strong>
    <%= cfp.external_url %>
  </p>

  <p>
    <strong>Open date:</strong>
    <%= cfp.open_date %>
  </p>

  <p>
    <strong>Close date:</strong>
    <%= cfp.close_date %>
  </p>

  <p>
    <strong>Events event:</strong>
    <%= cfp.events_event_id %>
  </p>

</article>
